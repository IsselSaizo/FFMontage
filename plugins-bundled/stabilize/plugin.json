{
  "id": "stabilize",
  "name": { "ru": "Стабилизация", "en": "Stabilization" },
  "version": "1.0.0",
  "apiVersion": 1,
  "description": {
    "ru": "Встроенный плагин без кода: убирает дрожание камеры. «Быстрая» — фильтр deshake за один проход, работает с любой сборкой FFmpeg. «Баланс» и «Максимум» — vidstab в два прохода: сначала программа в фоне анализирует движение клипа (сразу, как фильтр включён), потом экспорт стабилизирует по готовому анализу; нужна GPL-сборка FFmpeg с vidstab. Стабилизация идёт первой — до скорости, кадрирования и остальных фильтров. В плеере её видно, если включить «Показывать превью» (программа сделает копию клипа в низком разрешении).",
    "en": "Built-in code-free plugin: removes camera shake. “Fast” uses the deshake filter in one pass and works with any FFmpeg build. “Balanced” and “Maximum” use vidstab in two passes: the program first analyses the clip's motion in the background (as soon as the filter is turned on), then the export stabilizes using that analysis; this needs a GPL FFmpeg build with vidstab. Stabilization comes first — before speed, crop and the other filters. The player shows it if “Show preview” is on (the program makes a low-resolution copy of the clip)."
  },
  "author": "FF Montage",
  "contributes": {
    "effects": [
      {
        "id": "fast",
        "name": { "ru": "Стабилизация: быстрая", "en": "Stabilization: fast" },
        "stage": "source",
        "preview": "proxy",
        "params": [
          { "k": "range", "name": { "ru": "Размах тряски", "en": "Shake range" }, "min": 16, "max": 64, "step": 16, "def": 32, "unit": { "ru": "пикс.", "en": "px" } },
          { "k": "zoom", "name": { "ru": "Зум (прячет края)", "en": "Zoom (hides the edges)" }, "min": 0, "max": 20, "step": 0.5, "def": 4, "unit": "%" }
        ],
        "ffmpeg": [
          { "filter": "deshake", "args": { "rx": "{range:0}", "ry": "{range:0}", "edge": "mirror" } },
          { "filter": "scale", "args": { "w": "trunc(iw*{1 + zoom * 0.01:4}/2)*2", "h": "-2" }, "when": "zoom > 0" },
          { "filter": "crop", "args": { "w": "trunc(iw/{1 + zoom * 0.01:4}/2)*2", "h": "trunc(ih/{1 + zoom * 0.01:4}/2)*2" }, "when": "zoom > 0" }
        ]
      },
      {
        "id": "balanced",
        "name": { "ru": "Стабилизация: баланс", "en": "Stabilization: balanced" },
        "stage": "source",
        "preview": "proxy",
        "prepare": {
          "kind": "vidstab",
          "args": { "shakiness": "{shake:0}", "accuracy": "9", "stepsize": "12", "mincontrast": "0.3", "tripod": "{tripod:0}" }
        },
        "params": [
          { "k": "smooth", "name": { "ru": "Сглаживание", "en": "Smoothing" }, "min": 1, "max": 60, "step": 1, "def": 15, "unit": { "ru": "кадров", "en": "frames" } },
          { "k": "zoom", "name": { "ru": "Доп. зум", "en": "Extra zoom" }, "min": 0, "max": 20, "step": 0.5, "def": 0, "unit": "%" },
          { "k": "shake", "name": { "ru": "Сила тряски (анализ)", "en": "Shakiness (analysis)" }, "min": 1, "max": 10, "step": 1, "def": 5 },
          { "k": "tripod", "name": { "ru": "Штатив (камера неподвижна)", "en": "Tripod (static camera)" }, "min": 0, "max": 1, "step": 1, "def": 0 }
        ],
        "ffmpeg": [
          {
            "filter": "vidstabtransform",
            "args": { "input": "{trf}", "smoothing": "{smooth:0}", "optzoom": "1", "zoom": "{zoom:1}", "interpol": "bilinear", "tripod": "{tripod:0}" }
          }
        ]
      },
      {
        "id": "max",
        "name": { "ru": "Стабилизация: максимум", "en": "Stabilization: maximum" },
        "stage": "source",
        "preview": "proxy",
        "prepare": {
          "kind": "vidstab",
          "args": { "shakiness": "10", "accuracy": "15", "stepsize": "6", "mincontrast": "0.1", "tripod": "{tripod:0}" }
        },
        "params": [
          { "k": "smooth", "name": { "ru": "Сглаживание", "en": "Smoothing" }, "min": 1, "max": 100, "step": 1, "def": 30, "unit": { "ru": "кадров", "en": "frames" } },
          { "k": "zoom", "name": { "ru": "Доп. зум", "en": "Extra zoom" }, "min": 0, "max": 20, "step": 0.5, "def": 0, "unit": "%" },
          { "k": "sharpen", "name": { "ru": "Резкость", "en": "Sharpness" }, "min": 0, "max": 1.5, "step": 0.05, "def": 0.5 },
          { "k": "tripod", "name": { "ru": "Штатив (камера неподвижна)", "en": "Tripod (static camera)" }, "min": 0, "max": 1, "step": 1, "def": 0 }
        ],
        "ffmpeg": [
          {
            "filter": "vidstabtransform",
            "args": { "input": "{trf}", "smoothing": "{smooth:0}", "optzoom": "1", "zoom": "{zoom:1}", "interpol": "bicubic", "tripod": "{tripod:0}" }
          },
          { "filter": "unsharp", "args": { "lx": "5", "ly": "5", "la": "{sharpen:2}", "cx": "5", "cy": "5", "ca": "{sharpen:2}" }, "when": "sharpen > 0" }
        ]
      }
    ]
  },
  "permissions": [],
  "ffmpeg": { "filters": ["deshake", "scale", "crop", "vidstabtransform", "unsharp"] }
}
